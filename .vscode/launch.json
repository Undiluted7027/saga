{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Saga fixture extension",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}"],
      "outFiles": ["${workspaceFolder}/**/*.js"]
    }
  ]
}
