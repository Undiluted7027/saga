{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://saga.dev/schema/evidence-card-0.1.json",
  "title": "Saga Evidence Card",
  "type": "object",
  "required": ["schema_version", "target", "claims", "boundaries", "diagnostics"],
  "properties": {
    "schema_version": { "const": "0.1" },
    "target": { "$ref": "#/$defs/target" },
    "claims": { "type": "array", "items": { "$ref": "#/$defs/claim" } },
    "boundaries": { "type": "array", "items": { "$ref": "#/$defs/boundary" } },
    "diagnostics": { "type": "array", "items": { "$ref": "#/$defs/diagnostic" } }
  },
  "$defs": {
    "span": { "type": "object", "required": ["path", "start_line", "start_column", "end_line", "end_column"], "properties": { "path": { "type": "string" }, "start_line": { "type": "integer", "minimum": 1 }, "start_column": { "type": "integer", "minimum": 0 }, "end_line": { "type": "integer", "minimum": 1 }, "end_column": { "type": "integer", "minimum": 0 } } },
    "expression": { "type": "object", "required": ["kind"], "properties": { "kind": { "enum": ["name", "constant", "attribute", "subscript", "call", "boolean", "unary", "binary", "comparison"] }, "name": { "type": "string" }, "value": {}, "base": { "$ref": "#/$defs/expression" }, "index": { "$ref": "#/$defs/expression" }, "callee": { "type": "string" }, "arguments": { "type": "array", "items": { "$ref": "#/$defs/expression" } }, "operator": { "type": "string" }, "operators": { "type": "array", "items": { "type": "string" } }, "values": { "type": "array", "items": { "$ref": "#/$defs/expression" } }, "operand": { "$ref": "#/$defs/expression" }, "left": { "$ref": "#/$defs/expression" }, "right": { "$ref": "#/$defs/expression" }, "comparators": { "type": "array", "items": { "$ref": "#/$defs/expression" } } } },
    "target": { "type": "object", "required": ["path", "qualified_name", "name", "signature", "status", "source_span"], "properties": { "path": { "type": "string" }, "qualified_name": { "type": "string" }, "name": { "type": "string" }, "signature": { "type": "string" }, "status": { "enum": ["supported", "unsupported"] }, "source_span": { "anyOf": [{ "$ref": "#/$defs/span" }, { "type": "null" }] } } },
    "claim": { "type": "object", "required": ["id", "kind", "statement", "evidence", "source_spans", "assumptions", "boundary_ids"], "properties": { "id": { "type": "string" }, "kind": { "enum": ["rejected_input", "explicit_exception", "attempted_write", "known_effect", "return_dependency", "test_observation"] }, "statement": { "type": "object", "required": ["text"], "properties": { "text": { "type": "string" }, "type": { "enum": ["entry_guard", "explicit_exception", "assertion", "attempted_write", "known_effect", "return_dependency"] }, "condition": { "anyOf": [{ "$ref": "#/$defs/expression" }, { "type": "null" }] }, "exit": { "type": "object" }, "exception": { "type": "object" }, "target": { "type": "object" }, "effect": { "type": "object" }, "dependencies": { "type": "array", "items": { "type": "object" } } } }, "evidence": { "type": "object", "required": ["method", "evidence_class", "detail"], "properties": { "method": { "type": "string" }, "evidence_class": { "enum": ["derived", "observed"] }, "detail": { "type": "object" } } }, "source_spans": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/span" } }, "assumptions": { "type": "array", "items": { "type": "object", "required": ["text"], "properties": { "text": { "type": "string" } } } }, "boundary_ids": { "type": "array", "items": { "type": "string" } } } },
    "boundary": { "type": "object", "required": ["id", "kind", "target", "reason", "source_span"], "properties": { "id": { "type": "string" }, "kind": { "enum": ["unresolved_call", "dynamic_dispatch", "assignment_hooks", "unsupported_semantics"] }, "target": { "type": "object", "required": ["text"], "properties": { "text": { "type": "string" } } }, "reason": { "type": "string" }, "source_span": { "$ref": "#/$defs/span" } } },
    "diagnostic": { "type": "object", "required": ["kind", "message"], "properties": { "kind": { "type": "string" }, "message": { "type": "string" }, "source_span": { "$ref": "#/$defs/span" } } }
  }
}
